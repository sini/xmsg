---
/*
 * The landing hero: an attested message bus between agent harnesses, services,
 * federated nodes, leaf pods and gateways.
 *
 * Inline SVG animated in CSS. Every colour resolves through `--sl-color-*`, so
 * it follows the active palette like the rest of the site.
 */

type Node = { x: number; y: number; label?: string; hue: string };

const accent = 'var(--sl-color-accent)';
const blue = 'var(--sl-color-blue)';
const green = 'var(--sl-color-green)';
const purple = 'var(--sl-color-purple)';
const orange = 'var(--sl-color-orange)';

const nodes: Node[] = [
  { x: 64, y: 88, label: 'claude', hue: purple },
  { x: 58, y: 174, label: 'codex', hue: purple },
  { x: 86, y: 254, label: 'agy', hue: purple },
  { x: 162, y: 122, label: 'opencode', hue: blue },
  { x: 174, y: 218, label: 'pi', hue: blue },
  { x: 284, y: 164, label: 'xmsg@host', hue: accent },
  { x: 368, y: 72, label: 'subagent', hue: purple },
  { x: 382, y: 256, label: 'service', hue: green },
  { x: 478, y: 148, label: 'hub (mTLS)', hue: accent },
  { x: 586, y: 74, label: 'peer@node', hue: blue },
  { x: 598, y: 238, label: 'leaf pod', hue: green },
  { x: 696, y: 154, label: 'gateway', hue: orange },
];

const links: [number, number][] = [
  [0, 5], [1, 5], [2, 5], [3, 5], [4, 5],
  [5, 6], [5, 7], [0, 6],
  [5, 8], [7, 8],
  [8, 9], [8, 10], [8, 11],
  [9, 11], [10, 11], [5, 9],
];

const edges = links.map(([i, j]) => ({ a: nodes[i], b: nodes[j] }));

const path = ({ a, b }: { a: Node; b: Node }) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  const bow = Math.min(len * 0.12, 22);
  return `M ${a.x} ${a.y} Q ${mx - (dy / len) * bow} ${my + (dx / len) * bow}, ${b.x} ${b.y}`;
};
---

<div class="hero-graph" aria-hidden="true">
  <svg viewBox="0 0 760 310" role="presentation" preserveAspectRatio="xMidYMid meet">
    {edges.map((e, i) => <path class="edge" d={path(e)} style={`--i:${i}`} />)}
    {edges.map((e, i) => <path class="pulse" d={path(e)} style={`--i:${i}`} />)}
    {
      nodes.map((n, i) => (
        <circle
          class:list={['node', { keyed: n.label }]}
          cx={n.x}
          cy={n.y}
          r={n.label ? 8 : 4.5}
          style={`--i:${i}; --hue:${n.hue}`}
        />
      ))
    }
    {
      nodes.map((n, i) =>
        n.label ? (
          <text class="label" x={n.x} y={n.y - 17} text-anchor="middle" style={`--i:${i}`}>
            {n.label}
          </text>
        ) : null
      )
    }
  </svg>
</div>

<style>
  .hero-graph {
    margin: 0 0 1.5rem;
    width: 100%;
  }

  .hero-graph svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .edge {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.1;
    pathLength: 1;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    animation: draw 0.8s ease-out forwards;
    animation-delay: calc(var(--i) * 32ms);
  }

  .pulse {
    fill: none;
    stroke: var(--sl-color-accent-high);
    stroke-width: 2;
    stroke-linecap: round;
    pathLength: 1;
    stroke-dasharray: 0.05 0.95;
    stroke-dashoffset: 1;
    opacity: 0;
    animation: travel 5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    animation-delay: calc(1.1s + var(--i) * 42ms);
  }

  .node {
    fill: var(--sl-color-bg);
    stroke: var(--hue);
    stroke-width: 1.8;
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation: settle 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
    animation-delay: calc(0.3s + var(--i) * 42ms);
  }

  .node.keyed {
    stroke-width: 2.4;
    fill: color-mix(in srgb, var(--hue) 14%, var(--sl-color-bg));
  }

  .label {
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono, var(--__sl-font-mono));
    font-size: 12px;
    letter-spacing: 0.04em;
    opacity: 0;
    animation: fade 0.6s ease-out forwards;
    animation-delay: calc(0.9s + var(--i) * 42ms);
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes settle {
    from { opacity: 0; scale: 0.3; }
    to { opacity: 1; scale: 1; }
  }

  @keyframes fade {
    to { opacity: 1; }
  }

  @keyframes travel {
    0% { stroke-dashoffset: 1; opacity: 0; }
    6% { opacity: 0.85; }
    52% { stroke-dashoffset: 0; opacity: 0.85; }
    64%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge,
    .node,
    .label {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }

    .pulse {
      display: none;
    }
  }
</style>
