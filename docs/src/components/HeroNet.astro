---
/*
 * The landing hero's picture: sessions on several machines, joined by routes.
 * Everything is drawn statically; the only motion is a packet travelling each
 * route, added under prefers-reduced-motion: no-preference. Without it (or
 * with the animation never running) the full diagram is still there.
 */
type Pill = { x: number; y: number; text: string; hot?: boolean };
type Frame = { x: number; y: number; label: string; pills: Pill[] };

const W = 200;
const frames: Frame[] = [
  { x: 8, y: 14, label: 'alice.workstation', pills: [
    { x: 22, y: 46, text: 'claude · orchestrator', hot: true },
    { x: 22, y: 80, text: 'agy · docs' },
  ] },
  { x: 272, y: 14, label: 'alice.buildbox', pills: [
    { x: 286, y: 46, text: 'codex · builder' },
    { x: 286, y: 80, text: 'codex · reviewer' },
  ] },
  { x: 8, y: 170, label: 'genie-guard.genie', pills: [
    { x: 22, y: 202, text: 'genie-guard · service' },
  ] },
  { x: 272, y: 170, label: 'gateway', pills: [
    { x: 286, y: 202, text: 'chatgpt · hosted' },
    { x: 286, y: 236, text: 'xmsg-mcp-gateway' },
  ] },
];

// Routes run pill edge to pill edge: the orchestrator reaches the build box
// and the gateway, and the docs session asks the genie service in its pod.
const routes = [
  'M194 59 C 240 59, 240 59, 286 59',
  'M194 59 C 240 59, 240 93, 286 93',
  'M160 106 C 160 140, 160 170, 160 202',
  'M194 59 C 250 59, 230 249, 286 249',
];
---

<figure class="xm-net">
  <svg viewBox="0 0 480 290" role="img" aria-labelledby="xm-net-t xm-net-d">
    <title id="xm-net-t">Agent sessions on four machines, connected by xmsg</title>
    <desc id="xm-net-d">
      An orchestrator Claude Code session on a workstation has routes to two Codex sessions on a
      build box and to the MCP gateway, which a hosted ChatGPT client uses. An Antigravity session
      on the workstation has a route to the genie-guard service in a Kubernetes pod.
    </desc>
    {routes.map((d) => <path class="route" d={d} />)}
    {
      frames.map((f) => (
        <g>
          <rect class="frame" x={f.x} y={f.y} width={W} height={f.pills.length * 34 + 46} rx="10" />
          <text class="flabel" x={f.x + 14} y={f.y + 21}>{f.label}</text>
          {f.pills.map((p) => (
            <g class:list={['pill', { hot: p.hot }]}>
              <rect x={p.x} y={p.y} width={W - 28} height="26" rx="13" />
              <circle cx={p.x + 13} cy={p.y + 13} r="4" />
              <text x={p.x + 24} y={p.y + 17}>{p.text}</text>
            </g>
          ))}
        </g>
      ))
    }
    {routes.map((d, i) => <circle class="packet" r="4" style={`offset-path: path('${d}'); --i:${i}`} />)}
  </svg>
</figure>

<style>
  .xm-net { margin: 0; }
  .xm-net svg { display: block; width: 100%; height: auto; }

  .frame {
    fill: color-mix(in srgb, var(--sl-color-bg-nav) 70%, transparent);
    stroke: var(--sl-color-hairline-light);
  }

  .flabel {
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 11px;
  }

  .pill rect { fill: var(--sl-color-bg); stroke: var(--sl-color-gray-5); }
  .pill circle { fill: var(--sl-color-blue); }
  .pill text {
    fill: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 11px;
  }

  .pill.hot rect { stroke: var(--sl-color-accent); }
  .pill.hot circle { fill: var(--sl-color-accent); }

  .route {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  /* Packets are decoration: absent unless motion is welcome. */
  .packet { display: none; fill: var(--sl-color-accent); }

  @media (prefers-reduced-motion: no-preference) {
    .packet {
      display: inline;
      offset-rotate: 0deg;
      animation: xm-travel 3.6s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.9s);
    }

    @keyframes xm-travel {
      0% { offset-distance: 0%; opacity: 0; }
      10% { opacity: 1; }
      85% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
  }
</style>
