  {
    "label": "owner-every-request",
    "target": "lib",
    "test": "observe_collector_auth::tests::revalidation",
    "test_file": "src/observe_collector_auth_tests.rs",
    "expected_literal": "every request must revalidate activity",
    "edits": [
      {
        "file": "src/observe_collector_auth.rs",
        "start": "pub struct Verifier {",
        "needle": "    clock: EpochClock,",
        "replacement": "    clock: EpochClock,\n    cached_owner: std::sync::Mutex<Option<(String, u64)>>,"
      },
      {
        "file": "src/observe_collector_auth.rs",
        "needle": "            clock,\n",
        "replacement": "            clock,\n            cached_owner: std::sync::Mutex::new(None),\n"
      },
      {
        "file": "src/observe_collector_auth.rs",
        "needle": "        tokio::time::timeout(Duration::from_secs(2), self.introspect(token))\n            .await\n            .map_err(|_| AuthError::Unavailable)?",
        "replacement": "        let cached = { self.cached_owner.lock().unwrap().clone() };\n        if let Some((subject, expires_at)) = cached {\n            return Ok(VerifiedOwner { subject, expires_at });\n        }\n        let owner = tokio::time::timeout(Duration::from_secs(2), self.introspect(token))\n            .await.map_err(|_| AuthError::Unavailable)??;\n        *self.cached_owner.lock().unwrap() = Some((owner.subject.clone(), owner.expires_at));\n        Ok(owner)"
      }
    ]
  },
