[
  {
    "label": "owner-inactive",
    "target": "lib",
    "test": "observe_collector_auth::tests::inactive",
    "test_file": "src/observe_collector_auth_tests.rs",
    "expected_literal": "inactive owner must refuse",
    "edits": [
      {
        "file": "src/observe_collector_auth.rs",
        "needle": "claims.get(\"active\").and_then(Value::as_bool) != Some(true)",
        "replacement": "claims.get(\"active\").and_then(Value::as_bool).is_none()"
      }
    ],
    "test_macro": "denied_claim"
  },
