{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "canonicalNodeName",
    "tls",
    "ca",
    "peers",
    "trustedServices",
    "securityContext",
    "persistence",
    "networkPolicy"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "canonicalNodeName": {
      "type": "string",
      "minLength": 1
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingConfigMap"
      ],
      "properties": {
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "peers": {
      "type": "object"
    },
    "trustedServices": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "const": "/bin/xmsg"
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runAsUser",
        "runAsGroup",
        "fsGroup"
      ],
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "storageClassName"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowedPeers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "namespaceSelector"
                ]
              },
              {
                "required": [
                  "podSelector"
                ]
              }
            ],
            "properties": {
              "namespaceSelector": {
                "$ref": "#/definitions/labelSelector"
              },
              "podSelector": {
                "$ref": "#/definitions/labelSelector"
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    }
  },
  "definitions": {
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
